APP_NAME=SiteSentinel
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false (SECURITY.md §11).
# Debug mode must never render stack traces or config to a browser.
APP_ENV=production
# Root secret (§4.2 rule 7). NEVER commit a real key. Generate on the host with:
#   php artisan key:generate --show    (or)  docker compose exec app php artisan key:generate
# Rotating APP_KEY requires re-encrypting `encrypted` casts; keep the old key in
# APP_PREVIOUS_KEYS during rotation (SECURITY.md §12.1.4).
APP_KEY=CHANGE_ME_BASE64_32_BYTES
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://monitor.example.com
# Host name Nginx answers to in production (substituted into the Nginx template).
NGINX_SERVER_NAME=monitor.example.com

# Trusted reverse proxy (SECURITY.md §3.4 / §7). Behind the Nginx container,
# IP-keyed throttling (login, status unlock) only works if the proxy is trusted
# for X-Forwarded-*; otherwise every client collapses to one bucket.
# List the exact proxy addresses/CIDRs (never '*'). Leave empty to trust none.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# Canonical production database: MySQL 8 (InnoDB, utf8mb4) via Docker Compose.
# Local development convenience: SQLite (ADR-022). Never deploy SQLite.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sitesentinel
# Least-privilege application account (SECURITY.md §11 L20): DML on the app
# schema only — no SUPER, no cross-schema grants. Create with the grants in the
# RUNBOOK hand-off notes; never use the root account for the app.
DB_USERNAME=sitesentinel
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Root password is used ONLY for the initial container bootstrap + healthcheck.
# Store in the secret manager; not referenced by the application at runtime.
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# Local development (SQLite): set DB_CONNECTION=sqlite and create the file:
#   touch database/database.sqlite
# (DB_DATABASE then holds the database path, e.g. database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# PRODUCTION: set to the exact host served over TLS (no scheme), e.g.
# monitor.example.com. Leave unset (null) for local http development.
SESSION_DOMAIN=null
# PRODUCTION: true — cookies are only sent over HTTPS (SECURITY.md §2.5 / §10).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

# predis = pure-PHP client (no extension required); phpredis = C extension.
REDIS_CLIENT=predis
# Production (Docker Compose) uses the service hostname `redis`;
# local development may override with 127.0.0.1.
REDIS_HOST=redis
# Redis auth (SECURITY.md §11 L19 — Phase 9 BLOCKER). REQUIRED in production.
# Must be non-empty (the prod Compose file is fail-closed: it refuses to start
# without it). NEVER commit a real password. Generate/rotate/recover per
# RUNBOOK hand-off notes. Local dev without auth may leave this empty.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
# Optional Redis connection tuning (defaults exist in config/database.php).
# Separate logical DBs keep queue and cache keys from colliding.
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_USERNAME=
# REDIS_URL=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram Notification Channel (Phase 7; token belongs in secret store, never commit real values)
# Leave empty in repo. Set via environment/secret store on deploy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# SiteSentinel Monitoring Defaults (config/sentinel.php)
SENTINEL_DEFAULT_INTERVAL_SECONDS=300
SENTINEL_DEFAULT_TIMEOUT_SECONDS=10
SENTINEL_CONSECUTIVE_FAILURES_THRESHOLD=2
SENTINEL_CONSECUTIVE_SUCCESSES_THRESHOLD=2
SENTINEL_MAX_CONCURRENT_CHECKS=10

# SiteSentinel Probe Limits
SENTINEL_CONNECT_TIMEOUT_SECONDS=5
SENTINEL_TOTAL_REQUEST_TIMEOUT_SECONDS=15
SENTINEL_JOB_TIMEOUT_SECONDS=30
SENTINEL_DNS_TIMEOUT_SECONDS=3
SENTINEL_MAX_REDIRECT_HOPS=5
SENTINEL_MAX_RESPONSE_BODY_BYTES=2097152
SENTINEL_MAX_DECOMPRESSED_BYTES=10485760
SENTINEL_MAX_REDIRECT_CHAIN_BYTES=262144

# SiteSentinel Scoring Thresholds
SENTINEL_SCORING_THRESHOLD_INFO=1
SENTINEL_SCORING_THRESHOLD_WARNING=8
SENTINEL_SCORING_THRESHOLD_CRITICAL=15
SENTINEL_CORRELATION_GUARD_MIN_CATEGORIES=2
SENTINEL_CATEGORY_CAP=12

# SiteSentinel Notifications (config/sentinel.php `notifications`)
# Cooldown window between repeat alerts per website+channel (default 15 min).
SENTINEL_DEFAULT_COOLDOWN_MINUTES=15
# Retry policy fixed in code: SendNotification tries=3, backoff 60/300/900s,
# Telegram 429 honors retry_after. No env override at MVP.

# SiteSentinel Retention (Days)
SENTINEL_RETENTION_CHECKS_DAYS=30
SENTINEL_RETENTION_INCIDENTS_DAYS=365
SENTINEL_RETENTION_NOTIFICATION_LOGS_DAYS=90
SENTINEL_RETENTION_SNAPSHOTS_DAYS=14

# SiteSentinel Auth & Throttling (SECURITY.md §2.4)
SENTINEL_MAX_LOGIN_ATTEMPTS=5
SENTINEL_SOFT_LIMIT_WINDOW_MINUTES=15
SENTINEL_LOCKOUT_THRESHOLD=10
SENTINEL_LOCKOUT_WINDOW_MINUTES=30
SENTINEL_LOCKOUT_DURATION_MINUTES=15
SENTINEL_MIN_PASSWORD_LENGTH=12
SENTINEL_IDLE_TIMEOUT_MINUTES=30
SENTINEL_ABSOLUTE_TIMEOUT_MINUTES=480

# SiteSentinel Status Page (config/sentinel.php `status_page`, STATUS-PAGE.md §13)
# Projection cache floor (seconds) and TTL base = max(floor, shortest published interval).
SENTINEL_STATUS_TTL_FLOOR=60
# Staleness = max(multiplier x check_interval_seconds, floor seconds); missing last check = stale.
SENTINEL_STATUS_STALE_MULTIPLIER=2
SENTINEL_STATUS_STALE_FLOOR=300
# Unlock throttle: max attempts per window (minutes), keyed per IP + session.
SENTINEL_STATUS_UNLOCK_MAX=5
SENTINEL_STATUS_UNLOCK_WINDOW=10
# Day-level history is off by default and is deployment config (not persisted).
SENTINEL_STATUS_HISTORY_ENABLED=false
# Coarse response bands (milliseconds): <= normal -> "normal", <= slow -> "slow".
SENTINEL_STATUS_BAND_NORMAL=800
SENTINEL_STATUS_BAND_SLOW=2500
SENTINEL_STATUS_CACHE_PREFIX=status:projection:v1

# SiteSentinel Browser Push (config/sentinel.php `push`, NOTIFICATIONS.md §7.3, ADR-032)
# VAPID keys for Web Push. Generate once per deployment:
#   npx web-push generate-vapid-keys
# The PUBLIC key is served to the browser opt-in JS; the PRIVATE key is a secret
# (SECRET.md §4): never logged, never rendered, never placed in a payload.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact identifier for the push service (mailto: or https: subject).
VAPID_SUBJECT=mailto:admin@example.com
# Push message TTL in seconds.
VAPID_TTL_SECONDS=3600

# Settings version control (config/sentinel.php `settings`, ADR-043)
# "Pull update" never makes an outbound call. When set to a readable JSON file,
# the pull applies that file's registered keys (e.g. a git-tracked defaults file
# you keep in sync yourself); otherwise it reloads the latest stored snapshot.
SENTINEL_SETTINGS_UPSTREAM_PATH=
